package web

import (
	af "github.com/authfly/authkit/packages/ui/templ/authfly"
	"github.com/authfly/authkit/packages/ui/templ/ui/box"
	"github.com/authfly/authkit/packages/ui/templ/ui/button"
	"github.com/authfly/authkit/packages/ui/templ/ui/link"
	"github.com/authfly/authkit/packages/ui/templ/ui/text"
)

// Document is the HTML document skeleton (html, head, body). It is the one place that names document tags: ui8kit has
// no primitive for the document root. Everything inside body is built from the UI8Kit 3 primitives and the Authfly
// templ layer (authkit packages/ui/templ).
templ Document(title, locale string) {
	<!DOCTYPE html>
	<html lang={ locale }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/assets/app.css"/>
			<script src="/assets/theme.js"></script>
		</head>
		<body class="bg-background text-foreground">
			{ children... }
		</body>
	</html>
}

templ langSwitch(locale, path string) {
	@af.Group("2", "center", "", "", nil) {
		if locale != "en" {
			@link.Link(link.LinkProps{Href: "/auth/lang?set=en&next=" + path, Class: af.LinkSkin("text-sm")}) {
				{ "EN" }
			}
		} else {
			@text.Text(text.TextProps{Tag: "span", Class: "text-sm font-semibold"}) {
				{ "EN" }
			}
		}
		if locale != "ru" {
			@link.Link(link.LinkProps{Href: "/auth/lang?set=ru&next=" + path, Class: af.LinkSkin("text-sm")}) {
				{ "RU" }
			}
		} else {
			@text.Text(text.TextProps{Tag: "span", Class: "text-sm font-semibold"}) {
				{ "RU" }
			}
		}
	}
}

// Page is the Authfly page: a header with the product name, language and the theme toggle, the widget centered below.
templ Page(product, title, locale, path string) {
	@Document(title + " - " + product, locale) {
		@link.Link(link.LinkProps{Href: "#main", Class: "sr-only focus:not-sr-only"}) {
			{ map[bool]string{true: "К содержимому", false: "Skip to content"}[locale == "ru"] }
		}
		@box.Box(box.BoxProps{Tag: "header", Class: "w-full bg-card shadow-sm"}) {
			@box.Box(box.BoxProps{Class: "mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-4"}) {
				@link.Link(link.LinkProps{Href: "/", Class: "flex items-center gap-2 font-semibold"}) {
					@af.LucideIcon("shield-check", "md")
					@text.Text(text.TextProps{Tag: "span"}) {
						{ product }
					}
				}
				@af.Group("4", "center", "", "", nil) {
					@langSwitch(locale, path)
					@ThemeToggle()
				}
			}
		}
		@box.Box(box.BoxProps{Tag: "main", Class: "w-full px-4 py-8 sm:py-16", Attrs: af.A("id", "main")}) {
			{ children... }
		}
	}
}

// navItem is one sidebar entry: icon + label, aria-current on the active page, a visible focus ring.
templ navItem(href, icon, label, current string) {
	if current == href {
		@link.Link(link.LinkProps{Href: href, Class: "flex h-10 items-center gap-2 rounded-md bg-accent px-4 text-sm font-medium text-accent-foreground", AriaCurrent: "page", Attrs: af.A("data-testid", "nav-active")}) {
			@af.LucideIcon(icon, "sm")
			@text.Text(text.TextProps{Tag: "span"}) {
				{ label }
			}
		}
	} else {
		@link.Link(link.LinkProps{Href: href, Class: "flex h-10 items-center gap-2 rounded-md px-4 text-sm text-muted-foreground hover:bg-accent hover:text-accent-foreground"}) {
			@af.LucideIcon(icon, "sm")
			@text.Text(text.TextProps{Tag: "span"}) {
				{ label }
			}
		}
	}
}

// PortalShell is the signed-in account chrome: header (product, language, theme), a sidebar with the signed-in user
// and the sections (a wrapped row on phones, a column from md), and the page in main.
templ PortalShell(product, title, locale, path, nav string, home, personal, security, apps, privacy, signout, userName, userEmail, navLabel string) {
	@Document(title + " - " + product, locale) {
		@link.Link(link.LinkProps{Href: "#main", Class: "sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:rounded-md focus:bg-background focus:px-4 focus:py-2"}) {
			{ map[bool]string{true: "К содержимому", false: "Skip to content"}[locale == "ru"] }
		}
		@box.Box(box.BoxProps{Tag: "header", Class: "w-full bg-card shadow-sm"}) {
			@box.Box(box.BoxProps{Class: "mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-4"}) {
				@link.Link(link.LinkProps{Href: "/account", Class: "flex items-center gap-2 font-semibold"}) {
					@af.LucideIcon("shield-check", "md")
					@text.Text(text.TextProps{Tag: "span"}) {
						{ product }
					}
				}
				@af.Group("4", "center", "", "", nil) {
					@langSwitch(locale, path)
					@ThemeToggle()
				}
			}
		}
		@box.Box(box.BoxProps{Class: "mx-auto flex w-full max-w-6xl flex-col gap-8 px-4 py-8 md:flex-row"}) {
			@box.Box(box.BoxProps{Tag: "aside", Class: "w-full shrink-0 md:w-fit"}) {
				@af.Stack("4", "", "", "md:sticky md:top-8", nil) {
					@af.Group("2", "center", "", "min-w-0 px-4", af.A("data-testid", "portal-user")) {
						@af.IconBadge("circle-user", "")
						@af.Stack("0", "start", "", "min-w-0", nil) {
							@text.Text(text.TextProps{Class: "truncate text-sm font-semibold"}) {
								{ userName }
							}
							@text.Text(text.TextProps{Class: "truncate text-xs text-muted-foreground"}) {
								{ userEmail }
							}
						}
					}
					@box.Box(box.BoxProps{Tag: "nav", Class: "w-full", Attrs: af.A("aria-label", navLabel)}) {
						@box.Box(box.BoxProps{Class: "flex flex-wrap gap-2 md:flex-col md:flex-nowrap"}) {
							@navItem("/account", "house", home, nav)
							@navItem("/account/personal", "id-card", personal, nav)
							@navItem("/account/security", "lock-keyhole", security, nav)
							@navItem("/account/apps", "layout-grid", apps, nav)
							@navItem("/account/privacy", "shield", privacy, nav)
							@navItem("/auth/sign-out", "log-out", signout, "")
						}
					}
				}
			}
			@box.Box(box.BoxProps{Tag: "main", Class: "w-full min-w-0", Attrs: af.A("id", "main", "tabindex", "-1")}) {
				{ children... }
			}
		}
	}
}

// ThemeToggle: the Button primitive wired by assets/theme.js ([data-ui8kit="theme-toggle"], aria-pressed).
templ ThemeToggle() {
	@button.Button(button.ButtonProps{Type: "button", Class: af.ButtonSkin("ghost", "w-10 px-0"), AriaLabel: "Dark mode", AriaPressed: "false", Attrs: templ.Attributes{"data-ui8kit": "theme-toggle", "data-testid": "theme-toggle"}}) {
		@text.Text(text.TextProps{Tag: "span", Class: "dark:hidden"}) {
			@af.LucideIcon("moon", "md")
		}
		@text.Text(text.TextProps{Tag: "span", Class: "hidden dark:inline"}) {
			@af.LucideIcon("sun", "md")
		}
	}
}
