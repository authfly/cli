package web

import (
	"github.com/ui8kit/codegen/packages/templ/ui/ui/block"
	"github.com/ui8kit/codegen/packages/templ/ui/ui/container"
	"github.com/ui8kit/codegen/packages/templ/ui/ui/group"
	linkplain "github.com/ui8kit/codegen/packages/templ/ui/ui/link-plain"
	lucideicon "github.com/ui8kit/codegen/packages/templ/ui/ui/lucide-icon"
	"github.com/ui8kit/codegen/packages/templ/ui/ui/inline"
	"github.com/ui8kit/codegen/packages/templ/ui/ui/themetoggle"
)

// Document is the HTML document skeleton (html, head, body). It is the one place that names document tags: ui8kit has
// no primitive for the document root (the codegen host apps keep it in index.html too). Everything inside body is built
// from the generated primitives and Authkit widgets.
templ Document(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/assets/app.css"/>
			<script src="/assets/theme.js"></script>
		</head>
		<body class="bg-background text-foreground">
			{ children... }
		</body>
	</html>
}

// Page is the Authkit page: a header with the product name and the theme toggle, the widget centered below.
templ Page(product, title string) {
	@Document(title + " - " + product) {
		@block.Block(block.BlockProps{Tag: "header", Class: "w-full border-b border-border"}) {
			@container.Container(container.ContainerProps{Class: "mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-4"}) {
				@linkplain.LinkPlain(linkplain.LinkPlainProps{Href: "/", Class: "flex items-center gap-2 font-semibold"}) {
					@lucideicon.LucideIcon(lucideicon.LucideIconProps{Name: "shield-check", Size: 20})
					@inline.Inline(inline.InlineProps{}) {
						{ product }
					}
				}
				@group.Group(group.GroupProps{Gap: "2", Align: "center"}) {
					@themetoggle.ThemeToggle(themetoggle.ThemeToggleProps{Variant: "ghost", Size: "default", Attrs: templ.Attributes{"data-testid": "theme-toggle"}})
				}
			}
		}
		@block.Block(block.BlockProps{Tag: "main", Class: "w-full px-4 py-12"}) {
			{ children... }
		}
	}
}
